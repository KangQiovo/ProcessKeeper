<UserControl x:Class="ProcessKeeper.App.AutorunsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:ProcessKeeper.App">
 <Grid RowSpacing="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="Toolbar" ColumnSpacing="12" RowSpacing="8" SizeChanged="ToolbarSizeChanged">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ActionColumn" Width="Auto"/></Grid.ColumnDefinitions>
   <AutoSuggestBox x:Name="Search" QueryIcon="Find" PlaceholderText="{local:Loc Text='搜索软件、进程、PID 或路径'}" TextChanged="SearchChanged" AutomationProperties.Name="{local:Loc Text='搜索自启动项目'}"/>
   <StackPanel x:Name="ScanActions" Grid.Column="1" Orientation="Horizontal" Spacing="8">
    <ProgressRing x:Name="ScanProgress" Width="20" Height="20" IsActive="False"/>
    <Button x:Name="ScanButton" Click="ScanClicked" Content="{local:Loc Text='重新扫描'}"/>
    <Button x:Name="CancelScanButton" Click="CancelScanClicked" Content="{local:Loc Text='取消扫描'}" Visibility="Collapsed"/>
   </StackPanel>
  </Grid>
  <local:PresentationOptions x:Name="DisplayOptions" Grid.Row="1"/>
  <Grid Grid.Row="2" ColumnSpacing="12" SizeChanged="FilterBarSizeChanged">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="StateColumn" Width="*"/><ColumnDefinition x:Name="ModeColumn" Width="Auto"/></Grid.ColumnDefinitions>
   <ComboBox x:Name="SourceFilter" HorizontalAlignment="Stretch" SelectionChanged="FilterChanged" AutomationProperties.Name="{local:Loc Text='自启动来源'}"/>
   <ComboBox x:Name="StateFilter" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="FilterChanged" AutomationProperties.Name="{local:Loc Text='自启动状态'}"/>
   <ToggleSwitch x:Name="ComplexMode" Grid.Column="2" IsOn="False" OffContent="{local:Loc Text='简单'}" OnContent="{local:Loc Text='复杂'}" Toggled="ModeChanged" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left" MinWidth="0"/>
  </Grid>
  <Grid Grid.Row="3">
   <ListView x:Name="EntriesList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="EntryClicked" ContainerContentChanging="ContainerChanging" ContextRequested="EntryContextRequested" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8,10"/><Setter Property="Margin" Value="0,0,0,4"/></Style></ListView.ItemContainerStyle>
    <ListView.ItemTemplate>
     <DataTemplate>
      <Grid RowSpacing="10" Margin="{Binding RowMargin}">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <FontIcon Glyph="{Binding Chevron}" FontSize="12" VerticalAlignment="Center"/>
        <Image Grid.Column="1" Source="{Binding Icon}" Width="32" Height="32" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
         <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}"/>
         <TextBlock Text="{Binding Summary}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{Binding Summary}"/>
         <TextBlock Text="{Binding ProcessSummary}" FontSize="12" TextTrimming="CharacterEllipsis" Visibility="{Binding ProcessVisibility}"/>
        </StackPanel>
        <Button Grid.Column="3" Tag="{Binding}" Content="{Binding ActionText}" Visibility="{Binding ActionVisibility}" IsEnabled="{Binding CanAct}" Click="ChangeEntryClicked" VerticalAlignment="Center" MinWidth="72" ToolTipService.ToolTip="{Binding ActionHint}"/>
       </Grid>
       <StackPanel Grid.Row="1" Margin="60,0,0,0" Spacing="8" Visibility="{Binding DetailVisibility}">
        <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12"/>
        <TextBlock Text="{Binding ReadOnlyReason}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding ReadOnlyVisibility}"/>
       </StackPanel>
      </Grid>
     </DataTemplate>
    </ListView.ItemTemplate>
   </ListView>
   <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{local:Loc Text='正在读取自启动入口…'}" TextWrapping="Wrap" IsHitTestVisible="False"/>
  </Grid>
  <Grid Grid.Row="4" ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="Status" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   <Button Grid.Column="1" x:Name="CoverageButton" Click="CoverageClicked" Content="{local:Loc Text='扫描详情'}"/>
  </Grid>
 </Grid>
</UserControl>
