<Window x:Class="ProcessKeeper.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:ProcessKeeper.App" Title="Process Keeper">
 <Grid x:Name="Root" Loaded="InitializeResponsiveLayout" SizeChanged="WindowLayoutChanged">
  <Grid.Style><Style TargetType="Grid"><Setter Property="Background" Value="{ThemeResource ApplicationPageBackgroundThemeBrush}"/></Style></Grid.Style>
  <Grid.Resources><local:RoleKindVisibilityConverter x:Key="RoleKindVisibility"/><local:HiddenActionVisibilityConverter x:Key="HiddenActionVisibility"/></Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border x:Name="MaterialReadabilitySurface" Grid.RowSpan="2" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Opacity="0.85" Visibility="Collapsed" IsHitTestVisible="False"/>
  <Border x:Name="MaterialAcrylicPalette" Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" Visibility="Collapsed"/>
  <Grid x:Name="TitleBar" Padding="20,0,150,0" ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Image Width="28" Height="28" VerticalAlignment="Center"><Image.Source><BitmapImage UriSource="ms-appx:///Assets/ProcessKeeper.png" DecodePixelWidth="64"/></Image.Source></Image>
   <TextBlock Grid.Column="1" Text="Process Keeper" FontWeight="SemiBold" VerticalAlignment="Center"/>
  </Grid>
  <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Auto" CompactModeThresholdWidth="0" ExpandedModeThresholdWidth="1100" OpenPaneLength="194" CompactPaneLength="48" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="True" IsSettingsVisible="False" SelectionChanged="NavigationChanged" IsTabStop="False">
   <NavigationView.Transitions><TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="False"/></TransitionCollection></NavigationView.Transitions>
   <NavigationView.MenuItems>
    <NavigationViewItem Content="{local:Loc Text='运行中的程序'}" Tag="apps" IsSelected="True"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="{local:Loc Text='已安装应用'}" Tag="installed"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="{local:Loc Text='应用卸载'}" Tag="uninstall"><NavigationViewItem.Icon><FontIcon Glyph="&#xE74D;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="{local:Loc Text='自启动'}" Tag="autoruns"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7E8;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="{local:Loc Text='白名单'}" Tag="rules"><NavigationViewItem.Icon><FontIcon Glyph="&#xE73E;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="{local:Loc Text='操作记录'}" Tag="history"><NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="{local:Loc Text='设置'}" Tag="appearance"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="{local:Loc Text='杂项'}" Tag="misc"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8CB;"/></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.MenuItems>
   <NavigationView.PaneFooter>
    <StackPanel x:Name="NavigationFooter" Margin="14,0,12,16" Spacing="10">
     <TextBlock x:Name="PreviewBuildText" Text="{local:Loc Text='测试版本不代表最终品质'}" Style="{StaticResource SectionCaption}" TextWrapping="Wrap"/>
     <TextBlock x:Name="FooterVersionText" Style="{StaticResource SectionCaption}" TextWrapping="Wrap"/>
    </StackPanel>
   </NavigationView.PaneFooter>
   <Grid x:Name="PageContent" Padding="24,8,24,20" RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="20">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel x:Name="PageHeading" Spacing="6" VerticalAlignment="Top"><TextBlock x:Name="PageTitle" Text="{local:Loc Text='运行中的程序'}" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="{local:Loc Text='看清每个程序，让需要的留下。'}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Top" Margin="0,8,0,0">
      <ProgressRing x:Name="LoadingRing" Width="20" Height="20" IsActive="True"/>
     </StackPanel>
    </Grid>
    <StackPanel Grid.Row="1" Spacing="8">
     <InfoBar x:Name="RiskNotice" IsOpen="False" IsClosable="False" Severity="Error"/>
     <InfoBar x:Name="CompatibilityNotice" IsOpen="False" IsClosable="True" Severity="Error" Title="{local:Loc Text='兼容环境'}" Message="{local:Loc Text='部分视觉效果与功能可能与新系统的体验不同。'}" CloseButtonClick="DismissCompatibilityNotice"/>
     <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Informational"/>
    </StackPanel>
    <Grid x:Name="AppsPage" Grid.Row="2" RowSpacing="14">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid ColumnSpacing="16" VerticalAlignment="Top">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid x:Name="AppsToolbar" ColumnSpacing="10" SizeChanged="ApplicationAreaSizeChanged" VerticalAlignment="Top">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="SearchColumn" Width="*"/><ColumnDefinition x:Name="CategoryColumn" Width="170"/><ColumnDefinition x:Name="SortColumn" Width="140"/><ColumnDefinition x:Name="RefreshColumn" Width="Auto"/></Grid.ColumnDefinitions>
      <AutoSuggestBox x:Name="SearchBox" PlaceholderText="{local:Loc Text='搜索程序、进程、PID 或路径'}" QueryIcon="Find" TextChanged="SearchChanged" AutomationProperties.Name="{local:Loc Text='搜索运行中的程序'}"/>
      <ComboBox x:Name="CategoryFilter" Grid.Column="1" SelectedIndex="0" SelectionChanged="FilterChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="{local:Loc Text='运行状态筛选'}">
       <ComboBoxItem Content="{local:Loc Text='全部运行状态'}"/><ComboBoxItem Content="{local:Loc Text='有可见窗口'}"/><ComboBoxItem Content="{local:Loc Text='已最小化'}"/><ComboBoxItem Content="{local:Loc Text='隐藏后台'}"/><ComboBoxItem x:Name="SystemCategoryOption" Content="{local:Loc Text='服务与系统'}" IsEnabled="False"/>
      </ComboBox>
      <ComboBox x:Name="SortFilter" Grid.Column="2" SelectedIndex="0" SelectionChanged="FilterChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="{local:Loc Text='排序方式'}"><ComboBoxItem Content="{local:Loc Text='默认排序'}"/><ComboBoxItem Content="{local:Loc Text='按名称'}"/><ComboBoxItem Content="{local:Loc Text='按内存占用'}"/><ComboBoxItem Content="{local:Loc Text='按进程数量'}"/></ComboBox>
      <Button x:Name="RefreshButton" Grid.Column="3" Click="RefreshClicked" ToolTipService.ToolTip="{local:Loc Text='立即刷新'}" AutomationProperties.Name="{local:Loc Text='立即刷新'}"><FontIcon Glyph="&#xE72C;" FontSize="16"/></Button>
     </Grid>
      <ToggleSwitch x:Name="LiveToggle" Grid.Column="1" IsOn="True" OnContent="{local:Loc Text='实时更新'}" OffContent="{local:Loc Text='已暂停'}" FontSize="12" Width="138" MinWidth="0" VerticalAlignment="Top" Toggled="LiveRefreshChanged" AutomationProperties.Name="{local:Loc Text='实时更新进程状态'}" ToolTipService.ToolTip="{local:Loc Text='每 2 秒刷新；三个程序页面共用此设置。操作记录始终实时。'}"/>
     </Grid>
     <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="4" SizeChanged="BulkToolbarSizeChanged"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><local:PresentationOptions x:Name="RunningPresentationOptions"/><StackPanel x:Name="RunningBulkCommands" Grid.Column="1" Orientation="Horizontal" Spacing="8" ToolTipService.ToolTip="{local:Loc Text='选择当前列表中显示的应用和子项目，不更改白名单。'}"><Button x:Name="RunningSelectToggleButton" Content="{local:Loc Text='全选'}" Click="ToggleAllSelectionClicked"/></StackPanel></Grid>
     <Grid x:Name="SummaryBar" Grid.Row="2" ColumnSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel x:Name="SummaryLabels" Spacing="5"><TextBlock x:Name="SummaryText" Text="{local:Loc Text='正在读取本机进程…'}" Style="{StaticResource SectionCaption}" TextWrapping="Wrap"/><TextBlock x:Name="RunningListHint" Text="{local:Loc Text='单击展开或折叠 | 勾选保留或选择'}" Style="{StaticResource SectionCaption}" TextWrapping="Wrap"/></StackPanel><StackPanel x:Name="SummaryActions" Grid.Column="1" Orientation="Horizontal" Spacing="12"><CheckBox x:Name="ShowSystemToggle" Content="{local:Loc Text='显示系统与服务进程'}" IsChecked="False" Click="SystemVisibilityChanged" FontSize="12" VerticalAlignment="Center" ToolTipService.ToolTip="{local:Loc Text='默认隐藏系统与服务进程；显示后仍受系统保护。'}"/><Button x:Name="InspectorToggleButton" Content="{local:Loc Text='查看详情'}" Click="OpenInspector" IsEnabled="False" Visibility="Collapsed" VerticalAlignment="Center" ToolTipService.ToolTip="{local:Loc Text='先选择程序或进程，再查看详情'}"/></StackPanel></Grid>
     <SplitView x:Name="InspectorSplit" Grid.Row="3" DisplayMode="Inline" PanePlacement="Right" IsPaneOpen="True" OpenPaneLength="360" CompactPaneLength="0" BorderThickness="0" SizeChanged="ApplicationAreaSizeChanged" IsTabStop="False">
      <SplitView.Style><Style TargetType="SplitView"><Setter Property="PaneBackground" Value="{ThemeResource ApplicationPageBackgroundThemeBrush}"/></Style></SplitView.Style>
      <SplitView.Pane>
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
       <Grid x:Name="DetailPanel" RowSpacing="10" Padding="12,8,0,0" MinHeight="420">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{local:Loc Text='程序详情'}" Style="{StaticResource SectionCaption}" VerticalAlignment="Center"/><Button x:Name="InspectorCloseButton" Grid.Column="1" Content="{local:Loc Text='关闭详情'}" Visibility="Collapsed" Click="CloseInspector" Padding="8,4" FontSize="12"/></Grid><TextBlock x:Name="DetailName" Text="{local:Loc Text='选择一个程序'}" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="DetailSummary" Text="{local:Loc Text='查看它是什么、关联哪些进程，以及为什么被保留。'}" TextWrapping="Wrap" MaxLines="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/></StackPanel>
        <TextBlock Grid.Row="1" x:Name="DetailProtection" Text="{local:Loc Text='系统关键进程始终受保护'}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource KeeperAccentBrush}"/>
        <TextBlock Grid.Row="2" x:Name="DetailEvidence" Text="{local:Loc Text='父子关系表示启动来源，不一定属于同一程序。'}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Pivot Grid.Row="3">
         <PivotItem Header="{local:Loc Text='进程详情'}">
           <TextBox x:Name="ProcessFacts" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" FontSize="12" BorderThickness="0" Background="Transparent" Padding="0,8,0,0" AutomationProperties.Name="{local:Loc Text='选中进程的详细信息'}"/>
         </PivotItem>
         <PivotItem Header="{local:Loc Text='启动关系'}"><Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions><TreeView x:Name="ProcessTree" SelectionMode="Single" ItemInvoked="ProcessInvoked"/><ScrollViewer Grid.Row="1"><TextBlock x:Name="RelationshipText" TextWrapping="Wrap" FontSize="12" IsTextSelectionEnabled="True" LineHeight="21"/></ScrollViewer></Grid></PivotItem>
        </Pivot>
        <StackPanel Grid.Row="4" Spacing="8">
         <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ShowWindowButton" Content="{local:Loc Text='显示窗口'}" Click="ShowSelectedWindow" ToolTipService.ToolTip="{local:Loc Text='恢复已有窗口；只有隐藏主窗口时可尝试显示，没有窗口时查看原因'}"/><DropDownButton x:Name="MoreButton" Content="{local:Loc Text='更多'}"><DropDownButton.Flyout><MenuFlyout><MenuFlyoutItem x:Name="RevealHiddenWindowItem" Text="{local:Loc Text='尝试显示隐藏窗口…'}" Click="RevealSelectedHiddenWindow"/><MenuFlyoutItem x:Name="RestartAvdItem" Text="{local:Loc Text='以原生窗口重启 AVD…'}" Click="RestartSelectedAvd" Visibility="Collapsed"/><MenuFlyoutItem x:Name="SpecialWindowItem" Text="{local:Loc Text='打开专用界面…'}" Click="OpenSelectedSpecialWindow" Visibility="Collapsed"/><MenuFlyoutItem x:Name="MinimizeWindowItem" Text="{local:Loc Text='最小化窗口…'}" Click="MinimizeSelectedWindow"/><MenuFlyoutItem Text="{local:Loc Text='复制进程信息'}" Click="CopySelectedInformation"/><MenuFlyoutItem Text="{local:Loc Text='复制文件路径'}" Click="CopySelectedPath"/><MenuFlyoutItem x:Name="FolderButton" Text="{local:Loc Text='打开文件位置'}" Click="OpenSelectedFolder"/></MenuFlyout></DropDownButton.Flyout></DropDownButton></StackPanel>
         <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="AddSelectedButton" Content="{local:Loc Text='保留此程序'}" Click="KeepSelected"/><Button x:Name="CloseSelectedButton" Content="{local:Loc Text='关闭此程序…'}" Click="CloseSelected"/></StackPanel>
        </StackPanel>
       </Grid>
       </ScrollViewer>
      </SplitView.Pane>
      <Grid x:Name="ApplicationListArea" Margin="0,0,16,0"><local:ExpansionListView x:Name="AppsList" SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="False" SelectionChanged="AppSelectionChanged" Padding="0" HorizontalContentAlignment="Stretch">
       <ListView.ItemTemplate><DataTemplate x:DataType="local:AppRow">
        <Grid Padding="4,10" ColumnSpacing="10" Margin="{Binding RowMargin}" ToolTipService.ToolTip="{Binding Tooltip}">
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Button Click="AppChevronClicked" Visibility="{Binding ChevronVisibility}" Style="{StaticResource SubtleButtonStyle}" Padding="2" MinWidth="0" Width="22" MinHeight="24" Height="24" VerticalAlignment="Top" AutomationProperties.Name="{local:Loc Text='展开或折叠'}"><FontIcon Glyph="{Binding Chevron}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Button>
         <Image Grid.Column="1" Source="{Binding Icon}" Width="{Binding IconSize}" Height="{Binding IconSize}" VerticalAlignment="Top" Stretch="Uniform"/>
         <StackPanel Grid.Column="2" Spacing="4"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding RecoveryText}" Visibility="{Binding RecoveryVisibility}" ToolTipService.ToolTip="{Binding RecoveryTooltip}" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/></Grid><TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ProtectionText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
         <CheckBox Grid.Column="3" Content="{local:Loc Text='保留'}" Visibility="{Binding WhitelistVisibility}" IsChecked="{Binding IsWhitelisted,Mode=OneWay}" IsEnabled="{Binding CanWhitelist}" Tag="{Binding Key}" Click="WhitelistChecked" HorizontalAlignment="Right" VerticalAlignment="Top" MinWidth="0" FontSize="12" ToolTipService.ToolTip="{local:Loc Text='为这个程序添加或移除程序白名单规则'}"/>
         <CheckBox x:Name="RowSelection" Grid.Column="3" Content="{Binding SelectionText}" Visibility="{Binding WhitelistVisibility,Converter={StaticResource HiddenActionVisibility}}" local:RowSelectionCheckBox.Enabled="True" HorizontalAlignment="Right" VerticalAlignment="Top" MinWidth="0" FontSize="12" AutomationProperties.Name="{local:Loc Text='选择'}"/>
        </Grid>
       </DataTemplate></ListView.ItemTemplate>
      </local:ExpansionListView><TextBlock x:Name="EmptyListText" Text="{local:Loc Text='没有符合筛选条件的程序'}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid>
     </SplitView>
     <Grid x:Name="AppsFooter" Grid.Row="4" ColumnSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel x:Name="FooterLabels" VerticalAlignment="Center" Spacing="3"><TextBlock x:Name="RefreshStatus" Text="{local:Loc Text='正在连接本机进程信息'}" Style="{StaticResource SectionCaption}" TextWrapping="Wrap"/><TextBlock Text="{local:Loc Text='关闭前会显示清单并再次确认；不会自动关闭任何程序。'}" Style="{StaticResource SectionCaption}" TextWrapping="Wrap"/></StackPanel><Button x:Name="CloseOthersButton" Grid.Column="1" Content="{local:Loc Text='关闭未保留程序…'}" Click="CloseOthers" Style="{StaticResource AccentButtonStyle}" Padding="18,10"/></Grid>
    </Grid>
    <Grid x:Name="InstalledPage" Grid.Row="2" Visibility="Collapsed" RowSpacing="10">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid x:Name="InstalledToolbar" ColumnSpacing="16" RowSpacing="6" VerticalAlignment="Top">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid x:Name="InstalledSearchBar" ColumnSpacing="8" RowSpacing="8" SizeChanged="InstalledSearchBarChanged">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="InstalledDriveColumn" Width="Auto"/></Grid.ColumnDefinitions>
       <AutoSuggestBox x:Name="InstalledSearch" PlaceholderText="{local:Loc Text='搜索软件、进程、PID 或路径'}" QueryIcon="Find" TextChanged="InstalledSearchChanged" AutomationProperties.Name="{local:Loc Text='搜索已安装应用'}"/>
       <ComboBox x:Name="InstalledDriveFilter" Grid.Column="1" Width="150" HorizontalAlignment="Left" SelectionChanged="InstalledDriveChanged" AutomationProperties.Name="{local:Loc Text='按盘符筛选'}"/>
      </Grid>
      <StackPanel x:Name="InstalledCommands" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" SizeChanged="WrapCommandRowsChanged">
       <Button x:Name="InstalledScanButton" Click="RescanInstalled" Margin="0,0,8,6"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="14"/><TextBlock Text="{local:Loc Text='重新扫描'}"/></StackPanel></Button>
       <Button Content="{local:Loc Text='更新运行状态'}" Click="RefreshClicked" Margin="0,0,8,6"/>
       <DropDownButton x:Name="InstalledAddButton" Content="{local:Loc Text='添加软件'}" Margin="0,0,8,6"><DropDownButton.Flyout><MenuFlyout><MenuFlyoutItem Text="{local:Loc Text='选择可执行文件…'}" Click="AddInstalledExecutable"/><MenuFlyoutItem Text="{local:Loc Text='选择程序安装目录…'}" Click="AddInstalledDirectory"/></MenuFlyout></DropDownButton.Flyout></DropDownButton>
       <Button Content="{local:Loc Text='管理白名单'}" Click="ManageInstalledRules" Margin="0,0,8,6"/>
       <Button x:Name="InstalledSelectToggleButton" Content="{local:Loc Text='全选'}" Click="ToggleAllSelectionClicked" Margin="0,0,0,6"/>
      </StackPanel>
      <ToggleSwitch x:Name="InstalledLiveToggle" Grid.Column="1" IsOn="{Binding IsOn,ElementName=LiveToggle,Mode=OneWay}" Toggled="PageLiveRefreshChanged" OnContent="{local:Loc Text='实时更新'}" OffContent="{local:Loc Text='已暂停'}" FontSize="12" Width="138" MinWidth="0" VerticalAlignment="Top" AutomationProperties.Name="{local:Loc Text='实时更新进程状态'}" ToolTipService.ToolTip="{local:Loc Text='每 2 秒刷新；三个程序页面共用此设置。操作记录始终实时。'}"/>
     </Grid>
     <local:PresentationOptions x:Name="InstalledPresentationOptions" Grid.Row="1"/>
     <Grid x:Name="InstalledSummaryBar" Grid.Row="2" ColumnSpacing="14" RowSpacing="6" SizeChanged="InstalledSummarySizeChanged">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel x:Name="InstalledSummaryLabels" Spacing="5">
       <TextBlock x:Name="InstalledStatus" Text="{local:Loc Text='尚未扫描'}" Style="{StaticResource SectionCaption}" TextWrapping="Wrap"/>
       <TextBlock x:Name="InstalledListHint" Text="{local:Loc Text='单击展开或折叠 | 勾选保留或选择 | 推断标签可能有误，请谨慎甄别'}" TextWrapping="Wrap" Style="{StaticResource SectionCaption}"/>
      </StackPanel>
      <StackPanel x:Name="InstalledSummaryActions" Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Top">
       <ProgressRing x:Name="InstalledProgress" Width="16" Height="16" IsActive="False" Visibility="Collapsed"/>
       <CheckBox Content="{local:Loc Text='显示系统与服务进程'}" IsChecked="{Binding IsChecked,ElementName=ShowSystemToggle,Mode=OneWay}" Click="InstalledSystemVisibilityChanged" FontSize="12" ToolTipService.ToolTip="{local:Loc Text='与运行中的程序页共用显示设置。'}"/>
      </StackPanel>
     </Grid>
     <Grid Grid.Row="3">
      <local:ExpansionListView x:Name="InstalledList" SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="False" SelectionChanged="InstalledSelectionChanged" HorizontalContentAlignment="Stretch" Padding="0">
       <ListView.ItemTemplate><DataTemplate x:DataType="local:InstalledRow">
        <Grid Padding="4,10" ColumnSpacing="10" Margin="{Binding RowMargin}" ToolTipService.ToolTip="{Binding Details}">
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Button Click="InstalledChevronClicked" Visibility="{Binding ChevronVisibility}" Style="{StaticResource SubtleButtonStyle}" Padding="2" MinWidth="0" Width="22" MinHeight="24" Height="24" VerticalAlignment="Top" AutomationProperties.Name="{local:Loc Text='展开或折叠'}"><FontIcon Glyph="{Binding Chevron}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Button>
         <Image Grid.Column="1" Source="{Binding Icon}" Width="{Binding IconSize}" Height="{Binding IconSize}" VerticalAlignment="Top" Stretch="Uniform"/>
         <StackPanel Grid.Column="2" Spacing="4"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <Grid Grid.Column="1" Visibility="{Binding RoleVisibility}" ToolTipService.ToolTip="{Binding RoleTooltip}" VerticalAlignment="Center">
           <Border Visibility="{Binding RoleKind,Converter={StaticResource RoleKindVisibility},ConverterParameter=Main}" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="4" Padding="6,2"><TextBlock Text="{Binding RoleText}" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/></Border>
           <Border Visibility="{Binding RoleKind,Converter={StaticResource RoleKindVisibility},ConverterParameter=PossibleMain}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" CornerRadius="4" Padding="6,2"><TextBlock Text="{Binding RoleText}" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/></Border>
           <Border Visibility="{Binding RoleKind,Converter={StaticResource RoleKindVisibility},ConverterParameter='Uninstaller|PossibleUninstaller'}" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" CornerRadius="4" Padding="6,2"><TextBlock Text="{Binding RoleText}" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/></Border>
           <Border Visibility="{Binding RoleKind,Converter={StaticResource RoleKindVisibility},ConverterParameter='Helper|Diagnostic|Unknown'}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2"><TextBlock Text="{Binding RoleText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Border>
          </Grid><TextBlock Grid.Column="2" Text="{Binding RecoveryText}" Visibility="{Binding RecoveryVisibility}" ToolTipService.ToolTip="{Binding RecoveryTooltip}" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/></Grid><TextBlock Text="{Binding Summary}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{Binding Status}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
         <CheckBox Grid.Column="3" HorizontalAlignment="Right" Content="{Binding KeepText}" Tag="{Binding RowKey}" IsChecked="{Binding IsKept,Mode=OneWay}" IsEnabled="{Binding CanKeep}" Visibility="{Binding KeepVisibility}" Click="KeepInstalled" VerticalAlignment="Top" MinWidth="0" FontSize="12" ToolTipService.ToolTip="{local:Loc Text='勾选加入白名单；已保留项目可在白名单页调整，避免误删来自其他规则的保护。'}"/>
