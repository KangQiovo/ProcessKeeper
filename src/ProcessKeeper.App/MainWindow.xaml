                  <StackPanel Spacing="8"><TextBlock Text="{local:Loc Text='引用项目'}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{local:Loc Text='项目依赖与图标来源，完整许可见随附的第三方声明。'}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <ItemsControl x:Name="ReferencedProjectsList"><ItemsControl.ItemTemplate><DataTemplate><HyperlinkButton HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0,8" Click="OpenReferencedProject" Tag="{Binding}"><StackPanel Spacing="4"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></HyperlinkButton></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         </StackPanel><StackPanel Spacing="10"><TextBlock Text="{local:Loc Text='运行诊断'}" FontSize="19" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="{local:Loc Text='刷新诊断信息'}" Click="RefreshSettingsDiagnostics"/><Button Content="{local:Loc Text='复制诊断信息'}" Click="CopySettingsDiagnostics"/></StackPanel><TextBox x:Name="SettingsDiagnostics" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" FontSize="12" AutomationProperties.Name="{local:Loc Text='应用运行诊断信息'}"/><TextBlock Text="{local:Loc Text='不包含进程名称、路径或白名单内容。'}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                  <StackPanel Spacing="10"><TextBlock Text="{local:Loc Text='使用引导'}" FontSize="19" FontWeight="SemiBold"/><Button x:Name="CompatibilityCheckButton" Content="{local:Loc Text='运行环境检测'}" Click="CheckCompatibility"/><Button x:Name="ReopenIntroductionButton" Content="{local:Loc Text='重新进入引导（OOBE）'}" Click="ReopenIntroduction"/><TextBlock Text="{local:Loc Text='重新查看环境检测与介绍，不重置规则或设置。'}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><StackPanel Spacing="10"><TextBlock Text="{local:Loc Text='本机文件'}" FontSize="19" FontWeight="SemiBold"/><Button x:Name="ClearCacheButton" Content="{local:Loc Text='清理应用缓存'}" Click="ClearAppCache"/><TextBlock Text="{local:Loc Text='清理旧版本缓存、遗留更新包与未完成下载；使用中的文件、白名单和设置会保留。'}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Button Content="{local:Loc Text='打开配置与记录目录'}" Click="OpenConfigurationFolder"/><TextBlock Text="{local:Loc Text='规则、设置、备份和记录与分享的 EXE 分开保存。'}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
         <StackPanel Spacing="10"><Button x:Name="RiskModeButton" Content="{local:Loc Text='无视风险模式'}" Click="ChangeRiskMode"/><TextBlock Text="{local:Loc Text='仅本次运行生效；重新启动后恢复风险确认。'}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
        </StackPanel>
       </ScrollViewer>
      </PivotItem>
     </Pivot>
    </Grid>
   </Grid>
  </NavigationView>
 </Grid>
</Window>
