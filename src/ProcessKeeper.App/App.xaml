<Application x:Class="ProcessKeeper.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/></ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="KeeperAccentBrush" Color="#087F6C"/></ResourceDictionary>
        <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="KeeperAccentBrush" Color="#8CDCCB"/></ResourceDictionary>
        <ResourceDictionary x:Key="Default"><SolidColorBrush x:Key="KeeperAccentBrush" Color="#8CDCCB"/></ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <Style x:Key="SectionCaption" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/></Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
