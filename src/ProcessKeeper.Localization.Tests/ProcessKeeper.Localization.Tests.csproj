<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AllowUnsafeBlocks>true</AllowUnsafeBlocks><PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ProcessKeeper.Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../ProcessKeeper.Core/Localization/*.json" Link="Localization/%(Filename)%(Extension)" />
    <Compile Include="../ProcessKeeper.App/ViewPreferences.cs" Link="App/ViewPreferences.cs" />
    <Compile Include="../ProcessKeeper.App/AppearancePreferences.cs" Link="App/AppearancePreferences.cs" />
    <Compile Include="../ProcessKeeper.App/SettingsBundleStore.cs" Link="App/SettingsBundleStore.cs" />
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath></Reference>
  </ItemGroup>
</Project>
