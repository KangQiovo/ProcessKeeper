<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ProcessKeeper.Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <!-- Execute the production UI routing methods, replacing only WinUI controls/dialog presentation. -->
    <Compile Include="../ProcessKeeper.App/MainWindow.Windows.cs" Link="App/MainWindow.Windows.cs" />
  </ItemGroup>
</Project>
